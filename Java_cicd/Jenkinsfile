pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Maven Build and Test') {
            steps {
                dir('Java_cicd') {
                    bat 'java -version'
                    bat 'mvn -version'
                    bat 'mvn clean package'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Java_cicd') {
                    bat 'docker build -t student-management:latest .'
                }
            }
        }

        stage('Deploy Container') {
            steps {
                bat 'docker rm -f student-management-container 2>NUL || ver >NUL'
                bat 'docker run -d --name student-management-container -p 8081:8080 student-management:latest'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'curl.exe --fail --retry 30 --retry-delay 2 --retry-all-errors --max-time 5 http://localhost:8081/students'
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'CI/CD pipeline failed. Check the stage logs.'
        }
    }
}